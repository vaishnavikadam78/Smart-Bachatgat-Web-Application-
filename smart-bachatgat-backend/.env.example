# Smart Bachatgat backend environment configuration
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/bachatgat_db
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESEND_API_KEY=
SENDER_EMAIL=your.email@gmail.com

# Gmail SMTP (recommended — welcome + OTP emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_TLS=true
APP_URL=http://localhost:5174

# Notification mode must be PRODUCTION or DEMO
NOTIFICATION_MODE=PRODUCTION
PRODUCTION_NOTIFICATION_WINDOW_DAYS=2
DEMO_NOTIFICATION_WINDOW_MINUTES=10
LOAN_OVERDUE_PENALTY=50.0
